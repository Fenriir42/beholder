{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beholder",
  "version": "0.1.0",
  "identifier": "app.beholder.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Beholder",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#121318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' img: http://img.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "RolePlayingGame",
    "shortDescription": "Companion app for D&D 5e (2024) campaigns",
    "copyright": "Includes material from the SRD 5.2.1 by Wizards of the Coast LLC, CC-BY-4.0",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] }
    }
  }
}
