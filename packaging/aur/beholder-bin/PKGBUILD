# Maintainer: Fenriir42 <raid3r2205@gmail.com>
pkgname=beholder-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Companion app for D&D 5e (2024) campaigns"
arch=('x86_64')
url="https://github.com/Fenriir42/beholder"
license=('0BSD')
depends=('webkit2gtk-4.1' 'gtk3')
optdepends=('gnome-keyring: keep the session in the Secret Service'
            'kwallet: keep the session in the Secret Service')
provides=('beholder')
conflicts=('beholder')
source=("https://github.com/Fenriir42/beholder/releases/download/v${pkgver}/Beholder_${pkgver}_amd64.deb")
sha256sums=('2d0b156e57fedfd0501ddc5f07c5728443ca8f9cd80f55b5b89041fbc7e14210')
noextract=("Beholder_${pkgver}_amd64.deb")

package() {
  bsdtar -xf "Beholder_${pkgver}_amd64.deb" data.tar.gz
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/beholder" <<'LAUNCHER'
#!/bin/sh
setsid -f /usr/bin/beholder-desktop "$@" >/dev/null 2>&1
LAUNCHER
}
